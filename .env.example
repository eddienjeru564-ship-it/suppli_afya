# Copy to .env.local for local development, or set these in Vercel → Settings → Environment Variables.

# Public URL of the site. Payment callbacks and QR codes use it. Must be https in production.
# On Vercel it defaults to the deploy's own address (the production domain, or the preview's branch address).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Supabase, Neon…). Leave empty locally to use the embedded database in .data/.
# Required on Vercel. For Supabase use the transaction pooler (port 6543), copied from Connect, e.g.
# postgres://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- M-Pesa through PayHero (payhero.co.ke) ---
# Dashboard → API Keys. Either the username and password…
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# …or the ready-made "Basic …" token instead of both.
PAYHERO_AUTH_TOKEN=
# Dashboard → Payment Channels → My Payment Channels (a number).
PAYHERO_CHANNEL_ID=
# Optional. The secret in the callback URL; derived from the credentials if empty.
PAYHERO_CALLBACK_TOKEN=

# --- Cards through Paystack ---
PAYSTACK_SECRET_KEY=

# On-screen test payments. Automatic in development. "true" on a test deploy (Vercel builds are production
# builds) lets the whole journey run without payment keys. Never "true" on the live site.
PAYMENTS_ALLOW_TEST=

# WhatsApp community invite shown in the portal (hidden if empty).
NEXT_PUBLIC_COMMUNITY_URL=
# Suppli Afya support number, 2547XXXXXXXX.
NEXT_PUBLIC_SUPPLI_WHATSAPP=

# --- The installed app ---
# Morning reminder notifications. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as mailto: or https:
VAPID_SUBJECT=mailto:hello@suppliafya.co.ke
# Secret the scheduler sends to /api/cron/morning (Vercel Cron sends it automatically when set in the project).
CRON_SECRET=

# Shared with the distributor storefronts (suppli_afya-distributor_template, same variable there),
# so orders customers place on a storefront are filed in the distributor's portal. A long random string.
STOREFRONT_SECRET=
